rules_version = '2';

// Модель даних (за app.js):
//   users/{uid}                       -- профіль: lang, currency, walletSyncKey,
//                                         categoriesIncome, categoriesExpense, ...
//   users/{uid}/transactions/{id}
//   users/{uid}/savings/{id}
//   users/{uid}/savingsGoals/{id}
//   users/{uid}/pages/{id}
//
// Правило: кожен користувач може читати й писати ЛИШЕ власні документи.
// Cloud Function walletSync працює через Admin SDK і ці правила не зачіпають.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /transactions/{txId} {
        allow read, write: if isOwner(uid);
      }

      match /savings/{savingId} {
        allow read, write: if isOwner(uid);
      }

      match /savingsGoals/{goalId} {
        allow read, write: if isOwner(uid);
      }

      match /pages/{pageId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Все інше — заборонено за замовчуванням.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
